# Valori supportati: development | test | production. Default: development.
NODE_ENV=development
# Valori supportati: porta TCP intera 1-65535. Default: 3000.
API_PORT=3000
# Valori supportati: porta TCP libera dell'host 1-65535. Default: 8080.
WEB_PORT=8080
# Valori supportati: porta TCP libera dell'host 1-65535. Default: 8081.
ADMIN_PORT=8081
# Valori supportati: URL assoluto http:// o https:// dell'app pubblica, senza path. Default: http://localhost:8080.
APP_ORIGIN=http://localhost:8080
# Valori supportati: true | false. Default: false in locale; usare true dietro HTTPS in produzione.
COOKIE_SECURE=false
# Valori supportati: URI postgresql:// o postgres://. Default Docker Compose indicato sotto.
DATABASE_URL=postgresql://portfoliohub:portfoliohub@postgres:5432/portfoliohub
# Valori supportati: URI redis:// o rediss://. Default Docker Compose indicato sotto.
REDIS_URL=redis://redis:6379
# Valori supportati: URI amqp:// o amqps://. Default Docker Compose indicato sotto.
RABBITMQ_URL=amqp://portfoliohub:portfoliohub@rabbitmq:5672
# Valori supportati: qualsiasi path locale assoluto scrivibile. Default Docker Compose: /data/portfoliohub.
LOCAL_DATA_PATH=/data/portfoliohub
# Solo sviluppo locale: sostituire con 32 byte casuali in base64 fuori da Docker Compose.
# Valori supportati: stringa base64 che decodifica esattamente 32 byte. Default locale indicato sotto.
LOCAL_MASTER_KEY=UG9ydGZvbGlvSHViTG9jYWxEZXZNYXN0ZXJLZXkzMiE=
# Valori supportati: stringa casuale di almeno 32 caratteri. Default locale indicato sotto.
SESSION_PEPPER=portfoliohub-local-session-pepper-change-me
# Valori supportati: local | resend. Default: local.
EMAIL_PROVIDER=local
# Valori supportati: chiave API Resend re_... | vuoto con EMAIL_PROVIDER=local. Default: vuoto.
RESEND_API_KEY=
# Valori supportati: email oppure Nome <email>; il dominio deve essere verificato con Resend. Default indicato sotto.
EMAIL_FROM=PortfolioHub <portfoliohub@eulab.cloud>
# Casella operativa che riceve aperture e nuove risposte ai ticket, anche se non esiste ancora un utente staff attivo.
SUPPORT_EMAIL=eulabconsult@gmail.com
# Valori supportati: qualsiasi indirizzo email valido. Default locale: admin@portfoliohub.test.
ADMIN_EMAIL=
# Valori supportati: password da 12 a 200 caratteri. Default locale indicato sotto; sostituire in produzione.
ADMIN_PASSWORD=
# Valori supportati: local | aruba. Default: local.
STORAGE_PROVIDER=aruba
# Valori supportati: URL HTTPS assoluto del gateway PHP | vuoto con STORAGE_PROVIDER=local. Default: vuoto.
ARUBA_GATEWAY_URL=
# Valori supportati: identificatore condiviso di almeno 8 caratteri | vuoto con provider local. Default: vuoto.
ARUBA_GATEWAY_KEY_ID=
# Valori supportati: secret condiviso casuale di almeno 32 caratteri | vuoto con provider local. Default: vuoto.
ARUBA_GATEWAY_SECRET=
# Valori supportati: intero 10000-300000 millisecondi. Lock Redis rinnovato durante ogni PATCH; default 30000.
UPLOAD_LOCK_TTL_MS=30000
# Valori supportati: intero 1-1000. Massimo upload pending/in corso per account; default 100.
UPLOAD_MAX_ACTIVE_PER_ACCOUNT=100
# Valori supportati: intero 1-1000. Massimo upload pending/in corso dallo stesso IP; default 100.
UPLOAD_MAX_ACTIVE_PER_IP=100
# Valori supportati: intero 1-32 per replica storage-worker. Default consigliato: 4.
FILE_FINALIZE_CONCURRENCY=4
# Valori supportati: intero 1-16 per replica storage-worker. Default consigliato: 2.
FILE_MAINTENANCE_CONCURRENCY=2
# Valori supportati: intero 15000-600000 millisecondi, rinnovato durante la finalizzazione. Default: 60000.
FILE_FINALIZE_LEASE_MS=60000
# Valori supportati: intero 1-1000 e uguale a max_batch_items del config.php Aruba. Default: 250.
STORAGE_DELETE_BATCH_SIZE=250
# Valori supportati: intero 1-20. Numero di repliche Docker del worker storage; default consigliato: 2.
STORAGE_WORKER_REPLICAS=2
# Valori supportati: true | false. Deve essere true solo nei processi autorizzati a pubblicare l'outbox; default true.
OUTBOX_PUBLISHER_ENABLED=true
# Valori supportati: local | stripe. Default: local.
BILLING_PROVIDER=local
# Valori supportati: chiave Stripe sk_test_... | sk_live_... | vuoto con BILLING_PROVIDER=local. Default: vuoto.
STRIPE_SECRET_KEY=
# Valori supportati: chiave pubblicabile Stripe pk_test_... | pk_live_... | vuoto con BILLING_PROVIDER=local. Default: vuoto.
STRIPE_PUBLISHABLE_KEY=
# Valori supportati: signing secret Stripe whsec_... | vuoto con provider local. Default: vuoto.
STRIPE_WEBHOOK_SECRET=
# Valori supportati: Price ID Stripe price_... del piano Pro mensile | vuoto se non disponibile. Default: vuoto.
STRIPE_PRO_MONTHLY_PRICE_ID=
# Valori supportati: Price ID Stripe price_... del piano Pro annuale | vuoto se non disponibile. Default: vuoto.
STRIPE_PRO_ANNUAL_PRICE_ID=
# Valori supportati: Price ID Stripe price_... del piano Unlimited mensile | vuoto se non disponibile. Default: vuoto.
STRIPE_UNLIMITED_MONTHLY_PRICE_ID=
# Valori supportati: Price ID Stripe price_... del piano Unlimited annuale | vuoto se non disponibile. Default: vuoto.
STRIPE_UNLIMITED_ANNUAL_PRICE_ID=
# Limite di sola protezione del proxy web. Default 101g per consentire file applicativi fino a
# 100 GB; accetta valori Nginx come 300m, 2g, 101g. Non determina quote o limiti del piano.
NGINX_CLIENT_MAX_BODY_SIZE=101g
# Cache VPS di soli oggetti cifrati, in byte. Default 40 GiB; 0 la disabilita. Possibili valori:
# 10737418240 (10 GiB), 42949672960 (40 GiB), 107374182400 (100 GiB).
STORAGE_CACHE_MAX_BYTES=42949672960
