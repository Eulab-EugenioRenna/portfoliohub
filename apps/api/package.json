{
  "name": "@portfoliohub/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node ../../node_modules/@nestjs/cli/bin/nest.js build",
    "format": "biome format --write src test",
    "start": "node ../../node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node ../../node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "lint": "biome lint src test",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --project tsconfig.build.json --noEmit",
    "test": "node ../../node_modules/jest/bin/jest.js",
    "test:watch": "../../node_modules/node/bin/node ../../node_modules/jest/bin/jest.js --watch",
    "test:cov": "../../node_modules/node/bin/node ../../node_modules/jest/bin/jest.js --coverage",
    "test:debug": "../../node_modules/node/bin/node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "../../node_modules/node/bin/node ../../node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "amqplib": "2.0.1",
    "archiver": "^7.0.1",
    "argon2": "0.45.1",
    "bullmq": "5.79.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "joi": "18.2.3",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "22.4.0",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "0.10.8",
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
